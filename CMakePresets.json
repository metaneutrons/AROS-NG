{
  "version": 3,
  "configurePresets": [
    {
      "name": "pc-x86_64",
      "displayName": "AROS PC x86_64 (Native/Standalone)",
      "description": "64-bit x86 target with SMP and modern hardware support",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/pc-x86_64",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Generic",
        "CMAKE_SYSTEM_PROCESSOR": "x86_64",
        "CMAKE_C_COMPILER": "/opt/homebrew/opt/llvm/bin/clang",
        "CMAKE_CXX_COMPILER": "/opt/homebrew/opt/llvm/bin/clang++",
        "AROS_TARGET_CPU": "x86_64",
        "AROS_TARGET_PLATFORM": "pc",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "rpi-aarch64",
      "displayName": "AROS Raspberry Pi (AArch64 64-bit)",
      "description": "64-bit ARM target for Raspberry Pi 4 and 5",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/rpi-aarch64",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Generic",
        "CMAKE_SYSTEM_PROCESSOR": "aarch64",
        "CMAKE_C_COMPILER": "/opt/homebrew/opt/llvm/bin/clang",
        "CMAKE_CXX_COMPILER": "/opt/homebrew/opt/llvm/bin/clang++",
        "AROS_TARGET_CPU": "aarch64",
        "AROS_TARGET_PLATFORM": "raspi",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "arm-raspi",
      "displayName": "AROS Raspberry Pi (ARM 32-bit)",
      "description": "32-bit ARM target for Raspberry Pi 1, 2, 3",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/arm-raspi",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Generic",
        "CMAKE_SYSTEM_PROCESSOR": "arm",
        "CMAKE_C_COMPILER": "/opt/homebrew/opt/llvm/bin/clang",
        "CMAKE_CXX_COMPILER": "/opt/homebrew/opt/llvm/bin/clang++",
        "AROS_TARGET_CPU": "arm",
        "AROS_TARGET_PLATFORM": "raspi",
        "GCC_CONFIG_FLOAT_ABI": "hard",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ]
}
