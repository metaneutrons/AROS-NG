
include $(SRCDIR)/config/aros.cfg

TARGETDIR       := $(GENDIR)/$(CURDIR)
FILES           := boot serialdebug
ASMFILES        := startup64
USER_CFLAGS     := -Wall -ffreestanding -nostdlib $(CFLAGS_NO_BUILTIN)
USER_CPPFLAGS   := -DTARGET_SECTION_COMMENT=\"$(AROS_SECTION_COMMENT)\"
USER_INCLUDES   := -isystem $(SRCDIR)/$(CURDIR)/include
USER_AFLAGS     := -I$(GENINCDIR)
OPTIMIZATION_CFLAGS := -O2

#MM kernel-raspi-aarch64 : kernel-raspi-aarch64-bootimg
#MM kernel-raspi-aarch64-bootimg : includes

kernel-raspi-aarch64:
	@$(NOP)

#MM
kernel-raspi-aarch64-bootimg: $(AROSDIR)/aros-aarch64-raspi.img

BOOTSTRAP_LD := $(CROSSTOOLSDIR)/aarch64-aros-ld

$(AROSDIR)/aros-aarch64-raspi.img: $(foreach f, $(ASMFILES), $(TARGETDIR)/$(f).o) $(foreach f, $(FILES), $(TARGETDIR)/$(f).o)
	@$(ECHO) "Creating   $@"
	@$(MKDIR) $(dir $@)
	@$(BOOTSTRAP_LD) --entry=_start --script=$(SRCDIR)/$(CURDIR)/ldscript.lds \
		$(foreach f, $(ASMFILES), $(TARGETDIR)/$(f).o) \
		$(foreach f, $(FILES), $(TARGETDIR)/$(f).o) \
		-o $(TARGETDIR)/aros-aarch64-raspi.elf
	@$(TARGET_DEF_STRIP) $(TARGETDIR)/aros-aarch64-raspi.elf
	@$(TARGET_OBJCOPY) -O binary $(TARGETDIR)/aros-aarch64-raspi.elf $@

$(TARGETDIR)/%.o : %.c
	%compile_q

$(TARGETDIR)/%.o : %.S
	%compile_q

$(TARGETDIR)/%.d : %.c
	%mkdepend_q

DEPS := $(foreach f, $(FILES), $(TARGETDIR)/$(f).d)
-include $(DEPS)

%common
