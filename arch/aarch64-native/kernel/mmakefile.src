include $(SRCDIR)/config/aros.cfg

%set_archincludes mainmmake=kernel-kernel maindir=rom/kernel \
  modname=kernel pri=0 arch=raspi-aarch64 \
  includes="-I$(SRCDIR)/$(CURDIR)"

TARGETDIR := $(GENDIR)/$(CURDIR)

#MM kernel-raspi-aarch64 : kernel-raspi-aarch64-core
#MM kernel-raspi-aarch64-core : includes

kernel-raspi-aarch64:
	@$(NOP)

#MM
kernel-raspi-aarch64-core: $(OSGENDIR)/boot/core.elf

$(OSGENDIR)/boot/core.elf: $(TARGETDIR)/kernel_stub.o
	@$(ECHO) "Creating   $@"
	%mkdirs_q $(OSGENDIR)/boot
	@$(TARGET_LD) -T $(SRCDIR)/$(CURDIR)/ldscript.lds -o $@ $^

$(TARGETDIR)/kernel_stub.o: $(SRCDIR)/$(CURDIR)/kernel_stub.c
	%compile_q opt="-ffreestanding -nostdlib $(CFLAGS_NO_BUILTIN)"

%common
